<Project Sdk="Microsoft.NET.Sdk">

  <!-- La ventana a pantalla completa. Lee de HwPulse.Sensors y solo decide cómo se pinta.

       Sin MSIX y con los runtimes dentro (.NET y Windows App SDK): se copia la carpeta publicada
       a un servidor o PC y arranca sin instalar nada más que PawnIO. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HwPulse.App</RootNamespace>
    <AssemblyName>HwPulse</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>

    <!-- El punto de entrada es Program.cs: decide si ya hay un panel en marcha antes de arrancar
         la interfaz. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Aunque no haya MSIX: es lo que mete HwPulse.pri (con el XAML compilado dentro) en la carpeta
         publicada. Sin él la aplicación arranca y se cierra al abrir la ventana. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HwPulse.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Lo piden los generadores de C#/WinRT (las listas que van a ItemsSource) y de LibraryImport.
         No hay bloques unsafe escritos a mano. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HwPulse.Sensors\HwPulse.Sensors.csproj" />
  </ItemGroup>

  <!-- El .exe lleva el icono incrustado (Explorador, instalador); la ventana lo carga de este
       fichero para la barra de tareas y Alt+Tab. -->
  <ItemGroup>
    <Content Include="Assets\HwPulse.ico" Link="HwPulse.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
